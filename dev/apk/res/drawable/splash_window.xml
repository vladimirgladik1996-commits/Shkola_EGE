<?xml version="1.0" encoding="utf-8"?>
<!-- стартовое окно (Android 7–11) и накладка поверх WebView: тот же кремовый фон, что у прелоадера страницы, + иконка по центру -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/splash_bg"/>
        </shape>
    </item>
    <item android:gravity="center" android:width="112dp" android:height="112dp">
        <bitmap android:src="@drawable/splash_logo" android:gravity="fill"/>
    </item>
</layer-list>
