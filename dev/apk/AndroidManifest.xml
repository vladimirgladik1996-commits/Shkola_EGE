<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.kabinet.tutor.dev">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- камера: встроенная съёмка «Снять камерой» в чате ИИ (getUserMedia на странице);
         запасной путь (системная камера через ACTION_IMAGE_CAPTURE) разрешения не требует -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- микрофон нужен только голосовому помощнику: устройства без него не отсеиваем -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Android 11+: без <queries> система скрывает пакеты камеры (package visibility), и
         resolveActivity() для ACTION_IMAGE_CAPTURE возвращает null — «Снять камерой» не открывалось -->
    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <intent><action android:name="android.intent.action.GET_CONTENT" /></intent>
    </queries>
    <!-- съёмка камерой из чата ИИ («Снять камерой»): основной путь — встроенная камера приложения
         (getUserMedia, несколько снимков подряд); запасной — системное приложение камеры пишет
         снимок в наш content:// URI (MainActivity.onShowFileChooser → CaptureProvider) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application
        android:label="Надежда DEV"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name="ru.kabinet.tutor.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- возврат из Telegram после «Войти через Telegram»: страница бота /app-return открывает kabinet-dev://login;
                 singleTask — вернуться в уже запущенное приложение, а не открывать второе окно -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kabinet-dev" android:host="login" />
            </intent-filter>
        </activity>
        <!-- файл для снимка системной камеры: «Снять камерой» в чате с ИИ (MainActivity.onShowFileChooser → CaptureProvider) -->
        <provider
            android:name="ru.kabinet.tutor.CaptureProvider"
            android:authorities="ru.kabinet.tutor.dev.capture"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
