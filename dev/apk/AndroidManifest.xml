<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.kabinet.tutor.dev">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- микрофон нужен только голосовому помощнику: устройства без него не отсеиваем -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Android 11+: без <queries> система скрывает пакеты камеры (package visibility), и
         resolveActivity() для ACTION_IMAGE_CAPTURE возвращает null — «Снять камерой» не открывалось -->
    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <intent><action android:name="android.intent.action.GET_CONTENT" /></intent>
    </queries>
    <!-- съёмка камерой из чата ИИ («Снять камерой»): разрешения CAMERA не нужно —
         снимок делает системное приложение камеры и пишет его в наш content:// URI -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application
        android:label="Надежда DEV"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name="ru.kabinet.tutor.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- файл для снимка системной камеры: «Снять камерой» в чате с ИИ (MainActivity.onShowFileChooser → CaptureProvider) -->
        <provider
            android:name="ru.kabinet.tutor.CaptureProvider"
            android:authorities="ru.kabinet.tutor.dev.capture"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
