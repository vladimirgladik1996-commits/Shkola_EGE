# ============================================================
# DEV — локальная разработка.  Скопировать в .env и заполнить.
# .env НИКОГДА не коммитим (он в .gitignore).
# ============================================================

# Токен бота из @BotFather. Только на вашей машине / в секретах, не в чат.
BOT_TOKEN=123456789:ABCDEF...   # подставить настоящий токен

# Кому разрешён доступ (бот и кабинет): @ники через запятую, без @. По умолчанию — три человека ниже.
# После первого успешного входа ник «прибивается» к числовому Telegram-ID, и дальше человека определяет ID.
ALLOWED_USERNAMES=Gladik_Vladimir,Gladik_N,hungerrr
# Необязательно: числовые Telegram-ID (узнать у @userinfobot) — допускаются без проверки ника. OWNER_ID тоже работает.
ALLOWED_IDS=

# Адрес мини-аппа. В dev это публичный HTTPS-туннель:
#   cloudflared tunnel --url http://localhost:8080
#   или: ngrok http 8080
# Полученный https://... вставить сюда и продублировать в
# @BotFather → /setmenubutton (или /newapp).
WEBAPP_URL=https://ваш-туннель.trycloudflare.com

# Пусто: в dev фронт и API на одном домене (туннель проксирует и то, и другое).
# Если фронт открывается отдельно (file:// или другой хост) — укажите его origin.
ALLOW_ORIGIN=

PORT=8080
CURRENCY=₽

# --- подсказки для dev -------------------------------------------------
# • База создаётся автоматически: ./data/tutor.db.
#   Тестовые данные можно просто удалить файл.
# • В dev работаем в папке dev/ (эта). Проверенное переносим в prod/ — см. README в корне.

# --- авторизация (обязательна) -----------------------------------------
# Вход только по паролю — логин не нужен. scrypt-хэш пароля получить:  python auth.py
# (в Docker: docker compose run --rm bot python auth.py). Сам пароль нигде не хранится.
AUTH_PASSWORD_HASH=scrypt:...   # подставить результат python auth.py (--gen — случайный пароль)
# Публичный https-адрес backend (там открывается страница входа /login). Только https.
# Если страница и API на одном домене — можно не указывать (возьмётся WEBAPP_URL).
PUBLIC_URL=
# Пароль спрашивается один раз: сессия скользящая и продлевается при каждом использовании.
# Это срок БЕЗ активности (по умолчанию 30 дней), после него бот снова пришлёт ссылку для входа.
SESSION_DAYS=30

# Логи: DEBUG / INFO / WARNING. Лимит запросов к API с одного аккаунта в минуту (иначе — ответ 429).
APP_ENV=dev
LOG_LEVEL=DEBUG
API_RATE_PER_MIN=120

# Анти-сон выключен: dev-сервис спит без трафика и не тратит бесплатные часы.
KEEPALIVE_SEC=0

# --- ассистент: Kimi API (Moonshot AI) + Whisper (распознавание голоса) -----
# Ключи — только в .env / секретах хоста, не в чат и не в репозиторий.
# Без них ассистент отвечает заглушкой — остальной бот работает как обычно.

# Kimi: ключ с https://platform.kimi.ai/ → API Keys.
KIMI_API_KEY=
# Адрес API: https://api.moonshot.ai/v1 (международная) или https://api.moonshot.cn/v1 (Китай).
KIMI_BASE_URL=https://api.moonshot.ai/v1
# Модель разбора задач и быстрых ответов (дешёвая): kimi-k2.6.
KIMI_MODEL=kimi-k2.6
KIMI_MODEL_FAST=kimi-k2.6
# Сильная модель для сложных вопросов («глубокий разбор»): kimi-k3.
KIMI_MODEL_DEEP=kimi-k3
# Глубина размышления kimi-k3: low / high / max.
KIMI_EFFORT=max
# Лимит генерации НЕ задаём: у Kimi max_tokens = размышления + ответ СУММАРНО, и маленький
# лимит молча режет ответ (в файлы попадало не всё, что модель готовила). Пусто = без лимита:
# клиент передаёт огромный потолок и сам подбирает максимум, который принимает API (см. kimi.py).
# Ограничить явно — только осознанно: KIMI_MAX_TOKENS / KIMI_MAX_TOKENS_DEEP.
KIMI_MAX_TOKENS=
KIMI_MAX_TOKENS_DEEP=
KIMI_TIMEOUT=600
KIMI_TIMEOUT_DEEP=3600

# Whisper (голос → текст): OpenAI-совместимый /audio/transcriptions.
# Ключ — свой от сервиса распознавания. Для Groq: WHISPER_BASE_URL=https://api.groq.com/openai/v1
# и WHISPER_MODEL=whisper-large-v3-turbo.
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1
WHISPER_LANG=ru
WHISPER_TIMEOUT=60

# --- «ИИ-проверка»: Yandex Vision OCR (рукопись) + анализ лёгкой Kimi -----------
# Ключ Yandex Cloud (роль ai.vision.ocr.user) → API Keys в консоли Yandex Cloud.
# Используется модель handwritten для распознавания рукописных сочинений/эссе.
# Без него проверка не стартует (фронт покажет «off»).
YANDEX_API_KEY=
YANDEX_TIMEOUT=60
