# ============================================================
# PROD — рабочий сервер.  Скопировать в .env и заполнить НА СЕРВЕРЕ.
# .env НИКОГДА не коммитим (он в .gitignore).
# ============================================================

# Токен бота из @BotFather. Вводится ТОЛЬКО на сервере / в секретах хоста —
# не в чат, не в код, не в репозиторий.
BOT_TOKEN=123456789:ABCDEF...   # подставить настоящий токен

# Кому разрешён доступ (бот и кабинет): @ники через запятую, без @. По умолчанию — три человека ниже.
# После первого успешного входа ник «прибивается» к числовому Telegram-ID, и дальше человека определяет ID.
ALLOWED_USERNAMES=Gladik_Vladimir,Gladik_N,hungerrr
# Необязательно: числовые Telegram-ID (узнать у @userinfobot) — допускаются без проверки ника. OWNER_ID тоже работает.
ALLOWED_IDS=

# Публичный HTTPS-адрес мини-аппа. Для схемы «фронт на GitHub Pages» это
# адрес Pages-сайта; для схемы «всё с одного домена» — адрес backend.
WEBAPP_URL=https://vladimirgladik1996-commits.github.io/Shkola_EGE/

# Origin фронта — нужен для CORS, когда фронт и API на разных доменах.
# Для GitHub Pages: https://<username>.github.io
ALLOW_ORIGIN=https://vladimirgladik1996-commits.github.io

PORT=8080
CURRENCY=₽

# --- подсказки для prod ------------------------------------------------
# • Ветка main = прод. docs/ на main раздаётся GitHub Pages автоматически.
# • База ./data/tutor.db — живые ученики и платежи. Нужны регулярные бэкапы.
# • Запуск: docker compose up -d --build  (см. DEPLOY.md, сценарий C)
# • После смены BOT_TOKEN перезапустить сервис — HMAC-проверка initData
#   считается от токена бота.

# --- авторизация (обязательна) -----------------------------------------
# Логин и scrypt-хэш пароля. Хэш получить:  python auth.py
# (в Docker: docker compose run --rm bot python auth.py). Сам пароль нигде не хранится.
AUTH_LOGIN=Admin
AUTH_PASSWORD_HASH=scrypt:...   # подставить результат python auth.py (--gen — случайный пароль)
# Публичный https-адрес backend (там открывается страница входа /login). Только https.
# Если страница и API на одном домене — можно не указывать (возьмётся WEBAPP_URL).
PUBLIC_URL=
# Пароль спрашивается один раз: сессия скользящая и продлевается при каждом использовании.
# Это срок БЕЗ активности (по умолчанию 30 дней), после него бот снова пришлёт ссылку для входа.
SESSION_DAYS=30

# Резервное копирование базы: каждые N часов бот присылает файл tutor.db всем,
# у кого есть доступ. На free-тарифе Render диск эфемерный — это единственная
# защита данных. Восстановление: прислать файл боту обратно или ответить /restore.
BACKUP_HOURS=12

# Логи: DEBUG / INFO / WARNING. Лимит запросов к API с одного аккаунта в минуту (иначе — ответ 429).
LOG_LEVEL=INFO
API_RATE_PER_MIN=120
