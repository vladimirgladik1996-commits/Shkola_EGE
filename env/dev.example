# ============================================================
# DEV — локальная разработка.  Скопировать в .env и заполнить.
# .env НИКОГДА не коммитим (он в .gitignore).
# ============================================================

# Токен бота из @BotFather. Только на вашей машине / в секретах, не в чат.
BOT_TOKEN=123456789:ABCDEF...   # подставить настоящий токен

# Кому разрешён доступ (бот и кабинет): @ники через запятую, без @. По умолчанию — три человека ниже.
# После первого успешного входа ник «прибивается» к числовому Telegram-ID, и дальше человека определяет ID.
ALLOWED_USERNAMES=Gladik_Vladimir,Gladik_N,hungerrr
# Необязательно: числовые Telegram-ID (узнать у @userinfobot) — допускаются без проверки ника. OWNER_ID тоже работает.
ALLOWED_IDS=

# Адрес мини-аппа. В dev это публичный HTTPS-туннель:
#   cloudflared tunnel --url http://localhost:8080
#   или: ngrok http 8080
# Полученный https://... вставить сюда и продублировать в
# @BotFather → /setmenubutton (или /newapp).
WEBAPP_URL=https://ваш-туннель.trycloudflare.com

# Пусто: в dev фронт и API на одном домене (туннель проксирует и то, и другое).
# Если фронт открывается отдельно (file:// или другой хост) — укажите его origin.
ALLOW_ORIGIN=

PORT=8080
CURRENCY=₽

# --- подсказки для dev -------------------------------------------------
# • База создаётся автоматически: ./data/tutor.db.
#   Тестовые данные можно просто удалить файл.
# • Если API недоступен, мини-апп сам включает ДЕМО-режим и рисует
#   примерные данные с тостом «Демо-режим — данные примерные».
# • Ветка для разработки: dev. В main — только проверенное.

# --- авторизация (обязательна) -----------------------------------------
# Логин и scrypt-хэш пароля. Хэш получить:  python auth.py
# (в Docker: docker compose run --rm bot python auth.py). Сам пароль нигде не хранится.
AUTH_LOGIN=Admin
AUTH_PASSWORD_HASH=scrypt:...   # подставить результат python auth.py (--gen — случайный пароль)
# Публичный https-адрес backend (там открывается страница входа /login). Только https.
# Если страница и API на одном домене — можно не указывать (возьмётся WEBAPP_URL).
PUBLIC_URL=
# Пароль спрашивается один раз: сессия скользящая и продлевается при каждом использовании.
# Это срок БЕЗ активности (по умолчанию 30 дней), после него бот снова пришлёт ссылку для входа.
SESSION_DAYS=30

# Логи: DEBUG / INFO / WARNING. Лимит запросов к API с одного аккаунта в минуту (иначе — ответ 429).
LOG_LEVEL=INFO
API_RATE_PER_MIN=120
